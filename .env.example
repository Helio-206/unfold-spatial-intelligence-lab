# Server-side only. Never commit a real key and never expose it to Vite/frontend.
MODEL_API_KEY=
# Optional local backend port (default: 8787)
UNFOLD_BACKEND_PORT=8787

# Landing "Request access" destination (mailto:). Build-time. No address ships in the repo; while unset the action shows as unavailable.
VITE_UNFOLD_CONTACT_EMAIL=
